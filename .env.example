APP_NAME="SIP2M"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sip2m
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sip2m.test"
MAIL_FROM_NAME="${APP_NAME}"

# OTP login gate (OTP_ENABLED=false untuk melewati verifikasi OTP, mis. saat dev)
OTP_ENABLED=true
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Identitas lembaga (Profil Lembaga, kartu dasbor & halaman publik)
INSTITUSI_KODE_PT=000000
INSTITUSI_NAMA="Universitas Contoh"
INSTITUSI_KLASTER="Kelompok Pratama"

# Lembaga Penelitian
INSTITUSI_LEMBAGA="Lembaga Penelitian"
INSTITUSI_SK_PENDIRIAN="-"
INSTITUSI_ALAMAT="Gedung Rektorat"
INSTITUSI_TELEPON="-"
INSTITUSI_FAX="-"
INSTITUSI_EMAIL="lp@institusi.ac.id"
INSTITUSI_WEBSITE="-"
INSTITUSI_JABATAN_PIMPINAN="Ketua Lembaga Penelitian"
INSTITUSI_PIMPINAN_NAMA=
INSTITUSI_PIMPINAN_NIDN=

# Lembaga Pengabdian kepada Masyarakat (kosong = ikut Lembaga Penelitian)
INSTITUSI_LEMBAGA_PKM=
INSTITUSI_JABATAN_PIMPINAN_PKM="Ketua Lembaga Pengabdian kepada Masyarakat"
INSTITUSI_PIMPINAN_NAMA_PKM=
INSTITUSI_PIMPINAN_NIDN_PKM=

# Upload constraints (KB)
UPLOAD_MAX_PROPOSAL_KB=10240
UPLOAD_MAX_REPORT_KB=10240
UPLOAD_MAX_OUTPUT_KB=10240

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
